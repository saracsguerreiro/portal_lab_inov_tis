# ---------------------------------------------------------------- Aplicação
APP_URL=https://inovacao.tis.co.ao
# Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://inovacao.tis.co.ao
# Chave da cifra da autoria anónima (secções 5 e 14). Gere com: openssl rand -base64 48
ANON_KEY=

# ---------------------------------------------------------------- Base de dados (PostgreSQL)
DATABASE_URL=postgresql://utilizador:palavra-passe@servidor:5432/ecossistema
# QUEUE_INLINE=1 corre as tarefas sem worker (só para testes)

# ---------------------------------------------------------------- Microsoft Entra ID (colaboradores)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
TIS_EMAIL_DOMAIN=tis.co.ao

# ---------------------------------------------------------------- Email (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ecossistema de Inovação TIS <inovacao@tis.co.ao>"

# ---------------------------------------------------------------- Ficheiros (S3 compatível)
S3_ENDPOINT=
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ecossistema-privado

# ---------------------------------------------------------------- IA (endpoint compatível com a API da OpenAI)
# Vazio = fornecedor de teste (mock). Ex.: IA local do Lab (vLLM, Ollama, LM Studio).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------- Captcha (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Microsoft Teams
TEAMS_WEBHOOK_URL=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# ---------------------------------------------------------------- Jira e Confluence (activáveis em P36)
JIRA_USER=
JIRA_API_TOKEN=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=

# ---------------------------------------------------------------- Tarefas agendadas
CRON_SECRET=
